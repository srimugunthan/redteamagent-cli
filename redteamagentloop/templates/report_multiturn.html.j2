<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>RedTeamAgentLoop Multi-Turn Report — {{ report.session_id[:8] }}</title>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; background: #0f172a; color: #e2e8f0; line-height: 1.6; }
    .container { max-width: 1100px; margin: 0 auto; padding: 2rem; }
    h1 { font-size: 1.6rem; font-weight: 700; color: #f8fafc; margin-bottom: 0.25rem; }
    h2 { font-size: 1.1rem; font-weight: 600; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.08em; margin: 2rem 0 1rem; }
    h3 { font-size: 0.95rem; font-weight: 600; color: #cbd5e1; margin-bottom: 0.5rem; }
    .subtitle { color: #64748b; font-size: 0.9rem; margin-bottom: 2rem; }
    .mode-badge { display: inline-block; padding: 0.2rem 0.7rem; border-radius: 999px; font-size: 0.75rem; font-weight: 700; background: #1e3a5f; color: #7dd3fc; letter-spacing: 0.05em; }
    .summary-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 1rem; margin-bottom: 2rem; }
    .stat-card { background: #1e293b; border: 1px solid #334155; border-radius: 0.5rem; padding: 1rem; }
    .stat-card .value { font-size: 2rem; font-weight: 700; color: #f8fafc; }
    .stat-card .label { font-size: 0.8rem; color: #64748b; margin-top: 0.25rem; }
    .score-high { color: #f87171; font-weight: 700; }
    .score-mid  { color: #fbbf24; }
    .score-low  { color: #34d399; }
    .chart-wrap { background: #1e293b; border: 1px solid #334155; border-radius: 0.5rem; padding: 1.5rem; margin-bottom: 2rem; max-height: 300px; }
    .mono { font-family: "SF Mono", "Fira Code", monospace; font-size: 0.8rem; }
    .episode-block { background: #1e293b; border: 1px solid #334155; border-radius: 0.5rem; margin-bottom: 1.25rem; overflow: hidden; }
    .episode-header { display: flex; align-items: center; gap: 1rem; padding: 0.75rem 1rem; background: #0f1f35; border-bottom: 1px solid #334155; }
    .episode-num { font-size: 0.8rem; font-weight: 700; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.08em; }
    .ep-badge-success { background: #14532d; color: #86efac; padding: 0.15rem 0.5rem; border-radius: 999px; font-size: 0.72rem; font-weight: 700; }
    .ep-badge-fail    { background: #3b1f1f; color: #fca5a5; padding: 0.15rem 0.5rem; border-radius: 999px; font-size: 0.72rem; font-weight: 700; }
    .ep-score { margin-left: auto; font-size: 0.85rem; color: #94a3b8; }
    .turn-row { display: grid; grid-template-columns: 2.5rem 1fr 1fr 5rem 1fr; gap: 0.5rem; padding: 0.6rem 1rem; border-bottom: 1px solid #0f172a; font-size: 0.82rem; align-items: start; }
    .turn-row:last-child { border-bottom: none; }
    .turn-row:hover { background: #162032; }
    .turn-header { background: #162032; font-size: 0.75rem; font-weight: 600; color: #64748b; text-transform: uppercase; letter-spacing: 0.06em; }
    .turn-num { color: #475569; font-weight: 700; }
    .prompt-text { color: #cbd5e1; word-break: break-word; white-space: pre-wrap; }
    .response-text { color: #94a3b8; word-break: break-word; white-space: pre-wrap; }
    .rationale-text { color: #64748b; font-size: 0.78rem; white-space: pre-wrap; }
    .empty-state { color: #475569; text-align: center; padding: 2rem; font-style: italic; }
    footer { margin-top: 3rem; padding-top: 1rem; border-top: 1px solid #334155; color: #475569; font-size: 0.8rem; }
  </style>
</head>
<body>
<div class="container">

  <!-- Header -->
  <h1>RedTeamAgentLoop — Multi-Turn Report</h1>
  <p class="subtitle">
    Session <span class="mono">{{ report.session_id }}</span> &nbsp;·&nbsp;
    {{ report.generated_at }} &nbsp;·&nbsp;
    Target: <strong>{{ report.target_model }}</strong> &nbsp;·&nbsp;
    <span class="mode-badge">{{ report.mode }}</span>
  </p>

  <!-- Summary cards -->
  <div class="summary-grid">
    <div class="stat-card">
      <div class="value">{{ report.total_episodes }}</div>
      <div class="label">Episodes run</div>
    </div>
    <div class="stat-card">
      <div class="value {% if report.successful_episodes > 0 %}score-high{% else %}score-low{% endif %}">
        {{ report.successful_episodes }}
      </div>
      <div class="label">Successful episodes</div>
    </div>
    <div class="stat-card">
      <div class="value">{{ report.total_turns }}</div>
      <div class="label">Total turns</div>
    </div>
    <div class="stat-card">
      <div class="value">{{ report.max_turns_per_episode }}</div>
      <div class="label">Max turns / episode</div>
    </div>
    <div class="stat-card">
      <div class="value {% if report.best_score >= 7.0 %}score-high{% elif report.best_score >= 4.0 %}score-mid{% else %}score-low{% endif %}">
        {{ "%.1f"|format(report.best_score) }}
      </div>
      <div class="label">Best score</div>
    </div>
    <div class="stat-card">
      <div class="value">{{ "%.1f"|format(report.avg_score) }}</div>
      <div class="label">Average score</div>
    </div>
  </div>

  <!-- Score progression chart -->
  <h2>Score progression by episode</h2>
  <div class="chart-wrap">
    <canvas id="progressionChart"></canvas>
  </div>

  <!-- Per-episode conversation view -->
  <h2>Episodes ({{ report.total_episodes }} total)</h2>

  {% if report.episode_results %}
    {% for ep in report.episode_results %}
    <div class="episode-block">
      <div class="episode-header">
        <span class="episode-num">Episode {{ loop.index }}</span>
        {% if ep.successful %}
          <span class="ep-badge-success">SUCCESS</span>
        {% else %}
          <span class="ep-badge-fail">no breach</span>
        {% endif %}
        <span class="ep-score">
          {{ ep.turns_taken }} turn{{ 's' if ep.turns_taken != 1 else '' }} &nbsp;·&nbsp;
          best score
          <span class="{% if ep.best_score >= 7.0 %}score-high{% elif ep.best_score >= 4.0 %}score-mid{% else %}score-low{% endif %}">
            {{ "%.1f"|format(ep.best_score) }}
          </span>/10
        </span>
      </div>

      <!-- Turn header row -->
      <div class="turn-row turn-header">
        <div>Turn</div>
        <div>Prompt</div>
        <div>Response</div>
        <div>Score</div>
        <div>Rationale</div>
      </div>

      {% for rec in ep.attack_records %}
      {% if rec.score >= 7.0 %}
        {% set sc = "score-high" %}
      {% elif rec.score >= 4.0 %}
        {% set sc = "score-mid" %}
      {% else %}
        {% set sc = "score-low" %}
      {% endif %}
      <div class="turn-row">
        <div class="turn-num mono">{{ rec.iteration + 1 }}</div>
        <div class="prompt-text">{{ rec.prompt }}</div>
        <div class="response-text">{{ rec.response }}</div>
        <div class="mono {{ sc }}">{{ "%.1f"|format(rec.score) }}</div>
        <div class="rationale-text">{{ rec.score_rationale }}</div>
      </div>
      {% endfor %}
    </div>
    {% endfor %}
  {% else %}
    <div class="episode-block"><p class="empty-state">No episodes recorded.</p></div>
  {% endif %}

  <footer>Generated by RedTeamAgentLoop &nbsp;·&nbsp; {{ report.generated_at }}</footer>
</div>

<script>
const epData = {{ episode_chart_data | tojson }};
const maxTurns = Math.max(...epData.map(e => e.scores.length), 1);
const labels = Array.from({length: maxTurns}, (_, i) => `Turn ${i + 1}`);

const palette = [
  "rgba(99,179,237,0.9)",  "rgba(248,113,113,0.9)", "rgba(52,211,153,0.9)",
  "rgba(251,191,36,0.9)",  "rgba(167,139,250,0.9)", "rgba(251,146,60,0.9)",
  "rgba(244,114,182,0.9)", "rgba(94,234,212,0.9)",  "rgba(163,230,53,0.9)",
  "rgba(232,121,249,0.9)",
];

const datasets = epData.map((ep, i) => ({
  label: ep.label,
  data: ep.scores,
  borderColor: palette[i % palette.length],
  backgroundColor: "transparent",
  borderWidth: 2,
  pointRadius: 4,
  tension: 0.3,
}));

new Chart(document.getElementById("progressionChart"), {
  type: "line",
  data: { labels, datasets },
  options: {
    responsive: true,
    maintainAspectRatio: false,
    plugins: {
      legend: { labels: { color: "#94a3b8", font: { size: 11 } } },
    },
    scales: {
      y: {
        min: 0, max: 10,
        ticks: { color: "#94a3b8" },
        grid: { color: "#334155" },
      },
      x: {
        ticks: { color: "#94a3b8" },
        grid: { color: "#1e293b" },
      },
    },
  },
});
</script>
</body>
</html>
